[Unit]
Description=MuxCore Module - executor-shell
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/executor-shell \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id executor-shell
Environment=EXECUTOR_ALLOWED_COMMANDS=
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
